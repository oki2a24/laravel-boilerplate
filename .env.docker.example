# コンテナへ env_file で一括注入する変数（このファイルが実値の唯一の定義場所）。
# Compose (v5.6.1) の env_file 補間により、DB_URL はこのファイル内で先行定義した
# POSTGRES_* を参照して組み立てる（定義順序は必ず POSTGRES_* → DB_URL、
# :? ガードが未定義・定義漏れを検出して起動を停止する）。
#
# ┌ 設計意図（なぜ POSTGRES_* に単一定義するのか）────────────────────────
# │ 認証情報とDB名は POSTGRES_* に単一定義し、app コンテナへは
# │ 「Laravel が読む名前」= DB_URL（パス無し＝DB名を含まない）で渡す。
# │
# │ なぜ DB_DATABASE など Laravel が読む DB_* を注入してはならないか:
# │   env_file 注入された実環境変数（$_SERVER）は phpunit.xml の
# │   force="true" による上書きより優先される（phpunit は $_SERVER を
# │   書き換えない）。そのため DB_DATABASE=laravel を注入するとテストが
# │   phpunit.xml の laravel_test 上書きに失敗し、テストが開発DBに
# │   migrate する事故になる（実証済みの既存障害）。
# │
# │ DB名の決定順位（config/database.php の pgsql）:
# │   開発:    DB_DATABASE 無し → POSTGRES_DB フォールバック → laravel
# │   テスト:  phpunit.xml の DB_DATABASE=laravel_test が優先勝ち
# │   本番:    本番用 env ファイルの POSTGRES_DB（=本番DB名）
# │
# │ POSTGRES_* が app コンテナにも注入されるが、Laravel は普段読まない
# │ 名前のため無害（config のフォールバック位置でのみ参照する）。
# └────────────────────────────────────────────────────────────────────
#
# 使用方法: このファイルを .env.docker にコピー（本環境は gitignore 対象）。
#
# 注意: POSTGRES_PASSWORD に URL 特殊文字（@ : / ? # など）を使う場合は
# % エンコードすること（例: p@ss → p%40ss）。DB_URL は URL として解釈される。
APP_AXIOS_BASEURL=http://localhost

POSTGRES_DB=laravel
POSTGRES_USER=app
POSTGRES_PASSWORD=password

# Laravel 接続用URL（パス無し＝DB名を含めない。DB名は DB_DATABASE が担う）
DB_URL=pgsql://${POSTGRES_USER:?POSTGRES_USER must be defined above}:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be defined above}@db:5432?charset=utf8&prefix_indexes=true&schema=public&sslmode=prefer

CREATE_TEST_DB=true
